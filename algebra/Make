# Warnings set as error to avoid (re)introducing them
-arg -w -arg +duplicate-clear
-arg -w -arg +undeclared-scope
-arg -w -arg +deprecated-hint-without-locality
-arg -w -arg +deprecated-hint-rewrite-without-locality
